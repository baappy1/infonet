# WordPress GraphQL API
NEXT_PUBLIC_WORDPRESS_API_URL=https://your-wp.com/wordpress/infonet/graphql

# Frontend URL (used for SEO, blog sharing, etc.)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# WordPress menu ID (from Appearance → Menus)
NEXT_PUBLIC_PRIMARY_MENU_ID=28

# Blog page ID (WordPress page with insights blocks)
NEXT_PUBLIC_BLOG_PAGE_ID=0

# Secret for revalidation webhook
REVALIDATE_SECRET=your-secret
